{
  "expo": {
    "name": "Calarm",
    "slug": "Calarm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tempusqualis.calarm",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "fetch"
        ]
      },
      "notifications": {
        "icon": "./assets/icon.png",
        "sounds": [
          "./assets/sounds/alarm.caf"
        ]
      }
    },
    "android": {
      "package": "com.tempusqualis.calarm",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "USE_FULL_SCREEN_INTENT",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-asset",
      [
      "expo-audio",
        {
          "enableBackgroundPlayback" : true
        }
      ],
      ["expo-notifications", {
        "sounds": ["./assets/sounds/alarm.caf"]
      }]
    ]
  }
}
